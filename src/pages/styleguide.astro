---
// Design system review page (Phase 2). Not linked from the site and not indexed.
// Copy comes from src/data. Token names and hex values below are documentation, not site copy.
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import { studio, heroBeats, aiBenefits, founder, ctas, contactCopy } from '../data/studio';
import { services } from '../data/services';
import { featuredWork, publicView, labelText } from '../data/work';

const swatches = [
  { token: '--bg', hex: '#0A0B0D', use: 'Page background' },
  { token: '--bg-raised', hex: '#111317', use: 'Raised panels, cards' },
  { token: '--surface', hex: '#16191E', use: 'Inputs, controls' },
  { token: '--fg', hex: '#EEF1F4', use: 'Primary text' },
  { token: '--muted', hex: '#9AA3AD', use: 'Secondary text' },
  { token: '--line', hex: '#2A2F36', use: 'Decorative hairlines' },
  { token: '--line-strong', hex: '#656D77', use: 'Input and control borders' },
  { token: '--accent', hex: '#7DE3F0', use: 'Links, primary button' },
  { token: '--accent-fg', hex: '#06171A', use: 'Text on accent' },
];
const lastBeat = heroBeats.length - 1;
const firstService = services[0];
const work = publicView(featuredWork[0]);
const labels = contactCopy.formLabels;
---
<Base title={`Style guide: ${studio.name}`} noindex>
  <main id="main" class="sg">
    <section class="wrap" aria-labelledby="sg-colour">
      <h2 id="sg-colour">Colour</h2>
      <ul class="sg-swatches">
        {swatches.map((s) => (
          <li>
            <span class="sg-chip" style={`background:var(${s.token})`}></span>
            <code>{s.token}</code>
            <span class="label">{s.hex}</span>
            <span class="muted sg-use">{s.use}</span>
          </li>
        ))}
      </ul>
      <div class="sg-chrome" aria-hidden="true"></div>
      <p class="label"><code>--chrome</code></p>
    </section>

    <section class="wrap" aria-labelledby="sg-type">
      <h2 id="sg-type">Type</h2>
      <div class="sg-stack">
        <p class="beat">{heroBeats[1].heading}</p>
        <h1>{studio.headline}</h1>
        <h2>{firstService.title}</h2>
        <h3>{firstService.summary}</h3>
        <p class="lead">{studio.subline}</p>
        <p>{founder.bio}</p>
        <p class="label">{studio.heroLabels.join(' · ')}</p>
      </div>
    </section>

    <section class="wrap" aria-labelledby="sg-beats">
      <h2 id="sg-beats">Hero beats</h2>
      <div class="sg-stack">
        {heroBeats.map((beat, i) => (
          <div class="sg-beat">
            <p class={`display sg-beat-heading${i === lastBeat ? ' chrome-text' : ''}`}>{beat.heading}</p>
            {beat.text && <p class="lead muted">{beat.text}</p>}
            {beat.ctas && <p>{beat.ctas.map((key, j) => <a class={`btn ${j === 0 ? 'primary' : 'ghost'}`} href="#sg-beats">{ctas[key]}</a>)}</p>}
          </div>
        ))}
      </div>
    </section>

    <section class="wrap" aria-labelledby="sg-buttons">
      <h2 id="sg-buttons">Buttons</h2>
      <div class="sg-row">
        <a class="btn primary" href="#sg-buttons">{ctas.startProject}</a>
        <a class="btn ghost" href="#sg-buttons">{ctas.seeWork}</a>
        <button class="btn primary" type="button" disabled>{ctas.startProject}</button>
      </div>
    </section>

    <section class="wrap" aria-labelledby="sg-tags">
      <h2 id="sg-tags">Tags</h2>
      <ul class="tags">
        {firstService.deliverables.map((d) => <li>{d}</li>)}
      </ul>
    </section>

    <section class="wrap" aria-labelledby="sg-cards">
      <h2 id="sg-cards">Card</h2>
      <div class="grid">
        {aiBenefits.slice(0, 2).map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            <p class="muted">{b.text}</p>
          </article>
        ))}
        <article class="card">
          <p class="label">{labelText(work.label)}</p>
          <h3>{work.title}</h3>
          <p class="muted">{work.summary}</p>
        </article>
      </div>
    </section>

    <section class="wrap" aria-labelledby="sg-form">
      <h2 id="sg-form">Form</h2>
      <form class="sg-stack" onsubmit="return false" novalidate>
        <div class="field">
          <label for="sg-name">{labels.name}</label>
          <input id="sg-name" type="text" aria-describedby="sg-name-help" />
          <p class="help" id="sg-name-help">{contactCopy.nameHelp}</p>
        </div>
        <div class="field">
          <label for="sg-email">{labels.email}</label>
          <input id="sg-email" type="email" value="name@" aria-invalid="true" aria-describedby="sg-email-error" />
          <p class="error" id="sg-email-error">{contactCopy.errors.email}</p>
        </div>
        <div class="field">
          <label for="sg-service">{labels.service}</label>
          <select id="sg-service">
            {services.map((s) => <option value={s.slug}>{s.title}</option>)}
          </select>
        </div>
        <div><button class="btn primary" type="submit" disabled>{labels.submit}</button></div>
      </form>
    </section>

    <section class="wrap" aria-labelledby="sg-brand">
      <h2 id="sg-brand">Brand</h2>
      <div class="sg-brand-row">
        <div class="sg-mono sg-on-bg"><Monogram height={32} /></div>
        <div class="sg-mono sg-on-bg"><Monogram height={72} /></div>
        <div class="sg-mono sg-on-surface"><Monogram height={32} /></div>
        <div class="sg-mono sg-on-surface"><Monogram height={72} /></div>
      </div>
      <p class="display chrome-text sg-wordmark">{studio.name}</p>
    </section>
  </main>
</Base>

<style>
  .sg-stack { display: grid; gap: var(--space-l); }
  .sg-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); }

  .sg-swatches { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); padding: 0; margin: 0 0 var(--space-xl); list-style: none; }
  .sg-swatches li { display: grid; gap: var(--space-2xs); align-content: start; }
  .sg-chip { height: 4.5rem; border: 1px solid var(--line-strong); border-radius: var(--radius-card); margin-bottom: var(--space-xs); }
  .sg-swatches code { font-size: var(--step--1); }
  .sg-use { font-size: var(--step--1); }
  .sg-chrome { height: 5rem; border-radius: var(--radius-card); background: var(--chrome); }

  .sg-stack h1, .sg-stack h2, .sg-stack h3, .sg-stack p { margin: 0; }
  .sg-beat { display: grid; gap: var(--space-m); padding-block: var(--space-l); border-top: 1px solid var(--line); }
  .sg-beat:first-child { border-top: 0; }
  .sg-beat > * { margin: 0; }
  .sg-beat-heading { font-size: var(--step-4); line-height: 0.95; }

  .sg-brand-row { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin-bottom: var(--space-xl); }
  .sg-mono { display: grid; place-items: center; min-height: 9rem; border: 1px solid var(--line); border-radius: var(--radius-card); color: var(--fg); }
  .sg-on-bg { background: var(--bg); }
  .sg-on-surface { background: var(--surface); }
  .sg-wordmark { font-size: var(--step-4); line-height: 1; margin: 0; }

  @media (max-width: 767px) {
    .sg-brand-row { grid-template-columns: 1fr; }
  }
</style>
