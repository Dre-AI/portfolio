---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import Pipeline from '../components/Pipeline.astro';
import Work from '../components/Work.astro';
import About from '../components/About.astro';
import Timeline from '../components/Timeline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Proof />
    <Pipeline />
    <Work />
    <About />
    <Timeline />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  // The motion layer is progressive enhancement: fetch it only after the page has loaded, so it never
  // competes with the content (and never loads at all under reduced motion).
  if (document.documentElement.classList.contains('motion')) {
    const start = () => import('../scripts/motion/index.ts');
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
