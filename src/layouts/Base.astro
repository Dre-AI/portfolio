---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/archivo/wdth.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import { studio, founder } from '../data/studio';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = `${studio.name}: ${founder.role}`,
  description = studio.subline,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(base, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const logo = new URL(`${base}icon-512.png`, Astro.site);
const ogAlt = `${studio.name}: ${studio.headline}`;
const sameAs = Object.values(founder.links);

const person = {
  '@type': 'Person',
  name: founder.name,
  jobTitle: founder.role,
  email: `mailto:${founder.email}`,
  url: home.href,
  sameAs,
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: studio.name,
    description: studio.subline,
    url: home.href,
    logo: logo.href,
    address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
    founder: person,
  },
  { '@context': 'https://schema.org', ...person },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Motion gate, before first paint. .motion: animations allowed. .motion-hero: also scrub the hero frames
         (not on Save-Data or 2g, where the poster stays). Without JS neither class exists and the page is static. */}
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement, c = navigator.connection;
        var slow = c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || ''));
        root.classList.add('motion');
        if (!slow) root.classList.add('motion-hero');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
