---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { profile } from '../data/profile';
import { education, capabilities } from '../data/experience';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = `${profile.name}: ${profile.role}`,
  description = `${profile.role} in ${profile.location}. ${profile.subline}`,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(base, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const ogAlt = `${profile.name}, ${profile.role}: ${profile.headline}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  description: profile.subline,
  email: `mailto:${profile.email}`,
  url: home.href, // the person's home page, whichever page this is
  image: ogImage.href,
  alumniOf: education.map((ed) => ({ '@type': 'CollegeOrUniversity', name: ed.school })),
  knowsAbout: capabilities.flatMap((c) => c.items),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Motion gate, before first paint. .motion: animations allowed. .motion-hero: also scrub the hero frames
         (not on Save-Data or 2g, where the poster stays). Without JS neither class exists and the page is static. */}
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement, c = navigator.connection;
        var slow = c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || ''));
        root.classList.add('motion');
        if (!slow) root.classList.add('motion-hero');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#020617" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
