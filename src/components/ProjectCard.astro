---
import Monogram from './Monogram.astro';
import { labelText, type PublicWorkItem } from '../data/work';
import { services } from '../data/services';
import { ctas } from '../data/studio';
import { base, publicFileExists } from '../lib/content';

// `item` must come from publicView(); `showCover` is false for an unapproved concept (no screenshot of a client's site).
interface Props { item: PublicWorkItem; showCover?: boolean }
const { item, showCover = true } = Astro.props;

const cover = showCover && publicFileExists(item.cover) ? item.cover : undefined;
const label = labelText(item.label);
// "Built for" reads as a sentence with the client name; other labels stay a small kicker above the title.
const isBuiltFor = item.label === 'built-for';
const title = isBuiltFor ? `${label} ${item.title}` : item.title;
const tags = item.services.map((slug) => services.find((s) => s.slug === slug)?.title).filter((t): t is string => !!t);
---
<article class="card project" data-card>
  <div class="card-media">
    {cover ? (
      <img src={`${base}${cover}`} alt={`Screenshot of ${item.title}`} width="1600" height="1000" loading="lazy" decoding="async" />
    ) : (
      <div class="placeholder"><Monogram height={44} /></div>
    )}
  </div>
  {!isBuiltFor && <p class="label">{label}</p>}
  <h3>{title}</h3>
  <p class="muted">{item.summary}</p>
  {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
  <a class="link more" href={`${base}work/${item.slug}/`}>{ctas.caseStudy}<span class="visually-hidden">: {item.title}</span></a>
</article>

<style>
  h3 { font-size: var(--step-2); }
  /* No cover yet: a chrome-tinted surface with the monogram, never a fake screenshot. */
  .placeholder {
    position: relative; display: grid; place-items: center; width: 100%; height: 100%;
    background: var(--surface); color: var(--muted);
  }
  .placeholder::before { content: ''; position: absolute; inset: 0; background: var(--chrome); opacity: 0.12; }
  .placeholder :global(svg) { position: relative; }
  .more { display: inline-flex; align-items: center; min-height: 2.75rem; align-self: flex-start; margin-top: auto; }
</style>
