---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Project } from '../data/projects';

interface Props { project: Project }
const { project: p } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Never publish placeholders (CLAUDE.md): drop any field that still has [brackets] or TODO.
const ready = (text?: string) => !!text && !/\[|\]|TODO/.test(text);
const hasImage = !!p.image && existsSync(join(process.cwd(), 'public', p.image));
const details = [
  { term: 'Problem', text: p.problem },
  { term: 'What I built', text: p.built },
  { term: 'Result', text: p.result },
].filter((d) => ready(d.text));
---
<article class="card" data-card>
  {hasImage && (
    <div class="card-media">
      <img src={`${base}${p.image}`} alt={`Screenshot of ${p.title}`} width="1280" height="800" loading="lazy" decoding="async" />
    </div>
  )}
  <h3>{p.title}</h3>
  <p class="muted">{p.summary}</p>
  {details.length > 0 && (
    <dl>
      {details.map((d) => (<div><dt>{d.term}</dt><dd>{d.text}</dd></div>))}
    </dl>
  )}
  <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
  {p.link && <a class="link" href={p.link} rel="noopener">View live</a>}
</article>
