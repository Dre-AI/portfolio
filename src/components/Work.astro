---
import ProjectCard from './ProjectCard.astro';
import { featuredWork, moreBuilds, publicView } from '../data/work';
import { sections, ctas } from '../data/studio';

// Always render through publicView(): unapproved concepts stay anonymous and lose their cover.
const featured = featuredWork.map(publicView);
---
<section id="work" data-section="work">
  <div class="wrap">
    <h2>{sections.work}</h2>
    <div class="cases">
      {featured.map((item) => <ProjectCard item={item} />)}
    </div>

    <h3 class="more-title">{sections.moreBuilds}</h3>
    <ul class="more">
      {moreBuilds.map((build) => (
        <li>
          <h4>{build.title}</h4>
          <p class="muted">{build.summary}</p>
          <ul class="tags">{build.stack.map((s) => <li>{s}</li>)}</ul>
          {build.repoUrl && (
            <a class="link code" href={build.repoUrl} rel="noopener">{ctas.viewCode}<span class="visually-hidden">: {build.title}</span></a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cases { display: grid; gap: var(--space-l); margin-top: var(--space-2xl); align-items: start; }
  .more-title { margin: var(--space-3xl) 0 var(--space-l); font-size: var(--step-1); }
  .more { display: grid; gap: var(--space-l); margin: 0; padding: 0; list-style: none; }
  .more > li { display: grid; gap: var(--space-s); align-content: start; padding-top: var(--space-l); border-top: 1px solid var(--line); }
  .more > li > * { margin: 0; }
  h4 { font-size: var(--step-1); }
  .code { display: inline-flex; align-items: center; min-height: 2.75rem; justify-self: start; }
  @media (min-width: 768px) {
    .cases { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl); }
    .cases > :nth-child(even) { margin-top: var(--space-3xl); }
    .more { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-xl); }
  }
</style>
