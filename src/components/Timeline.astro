---
import { experience } from '../data/experience';
import { sections } from '../data/studio';
---
{/* src/scripts/motion/timeline.ts draws the rail on scroll via [data-timeline]. */}
<section id="experience" data-section="timeline">
  <div class="wrap layout">
    <h2>{sections.experience}</h2>
    <ol data-timeline>
      {experience.map((e) => (
        <li>
          <p class="label period">{e.period}</p>
          <div>
            <h3>{e.role}<span class="org">, {e.org}</span></h3>
            <p class="muted">{e.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout { display: grid; gap: var(--space-2xl); }
  h2 { margin: 0; }
  ol {
    --dot: 0.5625rem;
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The rail the motion script draws on scroll. */
  ol::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--dot) / 2 - 0.5px);
    width: 1px;
    background: var(--line);
  }
  li { position: relative; display: grid; gap: var(--space-2xs); padding: 0 0 var(--space-xl) calc(var(--dot) + var(--space-l)); }
  li:last-child { padding-bottom: 0; }
  li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--fg) 40%, var(--line));
    z-index: 1;
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  li:first-child::before { background: var(--accent); border-color: var(--accent); }
  /* Motion only (src/scripts/motion/timeline.ts): the accent line draws down and fills each dot it passes. */
  ol :global(.tl-fill) {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--dot) / 2 - 0.5px);
    width: 1px;
    background: var(--accent);
    transform-origin: top;
  }
  li.is-passed::before { background: var(--accent); border-color: var(--accent); }
  li p, h3 { margin: 0; }
  h3 { font-size: var(--step-1); line-height: 1.35; }
  .org { font-weight: 400; color: var(--muted); }
  .period { padding-top: 0.2rem; }

  @media (min-width: 768px) {
    li { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-xl); }
  }
</style>
