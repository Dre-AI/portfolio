---
import { experience, education } from '../data/experience';
import { sections } from '../data/site';
---
{/* Phase 4 draws the rail on scroll via [data-timeline]. */}
<section id="experience" data-section="timeline">
  <div class="wrap">
    <h2>{sections.experience.heading}</h2>
    <ol data-timeline>
      {experience.map((e) => (
        <li>
          <p class="label period">{e.period}</p>
          <div>
            <h3>{e.role}<span class="org">, {e.org}</span></h3>
            <p class="muted">{e.note}</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="edu-title">{sections.experience.education}</h3>
    <ul class="edu">
      {education.map((ed) => (
        <li>
          <p class="award">{ed.award}</p>
          <p class="muted">{ed.school}</p>
          <p class="label">{ed.period}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ol {
    --dot: 0.5625rem;
    position: relative;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }
  /* The rail Phase 4 draws on scroll. */
  ol::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--dot) / 2 - 0.5px);
    width: 1px;
    background: var(--line);
  }
  li { position: relative; display: grid; gap: var(--space-2xs); padding: 0 0 var(--space-xl) calc(var(--dot) + var(--space-l)); }
  li:last-child { padding-bottom: 0; }
  li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--fg) 40%, var(--line));
  }
  li:first-child::before { background: var(--accent); border-color: var(--accent); }
  li p, h3 { margin: 0; }
  h3 { font-size: var(--step-1); line-height: 1.35; }
  .org { font-weight: 400; color: var(--muted); }
  .period { padding-top: 0.2rem; }

  .edu-title { margin: var(--space-3xl) 0 var(--space-l); font-size: var(--step-1); }
  .edu { display: grid; gap: var(--space-l); margin: 0; padding: 0; list-style: none; }
  .edu li { padding: var(--space-m) 0 0; border-top: 1px solid var(--line); gap: var(--space-2xs); }
  .edu li::before { content: none; }
  .award { font-weight: 600; }

  @media (min-width: 768px) {
    li { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-xl); }
    .edu { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl); }
    .edu li { grid-template-columns: 1fr; gap: var(--space-2xs); }
  }
</style>
