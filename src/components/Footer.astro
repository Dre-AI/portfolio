---
import Monogram from './Monogram.astro';
import { studio, founder, nav } from '../data/studio';
import { base } from '../lib/content';
import { isHomePath, resolveNavHref } from '../lib/nav';

const isHome = isHomePath(Astro.url.pathname, base);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="brand">
      <Monogram height={28} />
      <p class="note">{studio.footerNote}</p>
      <p class="label">{studio.city}</p>
    </div>
    <ul class="links">
      {nav.map((item) => (
        <li><a href={resolveNavHref(item.href, base, isHome)}>{item.label}</a></li>
      ))}
      <li><a href={`mailto:${founder.email}`}>{founder.email}</a></li>
      <li><a href={founder.links.linkedin} rel="noopener">{founder.linkLabels.linkedin}</a></li>
      <li><a href={founder.links.github} rel="noopener">{founder.linkLabels.github}</a></li>
    </ul>
  </div>
  <div class="wrap legal">
    <p class="label">© {new Date().getFullYear()} {studio.name}</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); color: var(--muted); }
  .wrap { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--space-l, 1.5rem); padding-block: var(--space-xl); }
  .brand { display: grid; gap: var(--space-s); color: var(--fg); max-width: 32rem; }
  .brand .note { color: var(--muted); }
  .links { display: grid; gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .links a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--fg); }
  .legal { padding-block: var(--space-m); border-top: 1px solid var(--line); }
  p { margin: 0; }
</style>
