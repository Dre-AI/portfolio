---
import { profile } from '../data/profile';
import { capabilities } from '../data/experience';
import { sections } from '../data/site';
---
<section id="about" data-section="about">
  <div class="wrap">
    <div class="intro">
      <h2>{sections.about.heading}</h2>
      <p class="lead">{profile.about}</p>
    </div>
    <div class="groups">
      {capabilities.map((c) => (
        <div>
          <h3>{c.group}</h3>
          <ul class="tags">{c.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; gap: var(--space-2xl); }
  .lead { margin: 0; }
  .groups { display: grid; gap: var(--space-xl); }
  .groups > div { padding-top: var(--space-m); border-top: 1px solid var(--line); }
  h3 { font-size: var(--step-0); font-weight: 600; letter-spacing: -0.01em; margin-bottom: var(--space-s); }
  @media (min-width: 640px) { .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .wrap { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-3xl); align-items: start; }
  }
</style>
