---
import { profile } from '../data/profile';
import { cta } from '../data/site';
import { base, publicFileExists } from '../lib/content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const hasCv = publicFileExists(profile.cvFile);
// Frame counts, sizes and breakpoint for the scrubber, written by scripts/extract-frames.sh.
const frames = readFileSync(join(process.cwd(), 'public/hero/frames.json'), 'utf8');
const city = profile.location.split(',')[0];
---
{/* Always dark. src/scripts/motion/hero.ts scrubs the frame sequence into #hero-canvas and
     src/scripts/motion/interact.ts adds the cursor light and parallax; the poster (final frame) is what
     reduced motion, Save-Data, 2g and no-JS visitors see. */}
<section id="hero" class="hero media-scrim" data-section="hero" data-theme="dark"
  style={`--start-desktop:url(${base}hero/desktop/0001.webp);--start-mobile:url(${base}hero/mobile/0001.webp)`}>
  <img class="media poster" src={`${base}hero/poster.webp`} alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
  <canvas id="hero-canvas" class="media" aria-hidden="true" hidden data-base={`${base}hero/`} data-frames={frames}></canvas>
  <div class="light" aria-hidden="true"></div>
  <div class="wrap" data-hero-copy>
    <p class="status"><span class="avail"><span class="dot" aria-hidden="true"></span>{profile.availability}</span><span class="sep" aria-hidden="true"></span><span>{profile.role}, {city}</span></p>
    <h1><span class="grad-text">{profile.headline}</span></h1>
    <p class="lead muted">{profile.subline}</p>
    <p class="actions">
      <a class="btn primary" href="#work" data-magnetic>{cta.work}</a>
      {hasCv && <a class="btn" href={`${base}${profile.cvFile}`} download data-magnetic>{cta.cv}</a>}
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: max(34rem, 100dvh);
    padding-block: calc(4.5rem + var(--space-2xl)) var(--space-3xl); /* clears the fixed nav */
    border-top: 0;
    overflow: hidden;
  }
  .wrap { min-width: 0; } /* let the grid column shrink instead of growing to the longest word */
  .wrap > * { max-width: 38rem; }
  .wrap > h1 { max-width: 60rem; } /* two balanced lines on desktop */
  h1 { font-size: clamp(2.75rem, 1.4rem + 5.2vw, 5.25rem); line-height: 0.98; letter-spacing: -0.045em; margin-bottom: var(--space-l); padding-bottom: 0.08em; }
  .lead { margin: 0 0 var(--space-xl); max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin: 0; }

  /* Live status pill: the dot pulses because availability is real state, not decoration. */
  .status {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 0 var(--space-l);
    padding: 0.375rem 0.875rem;
    border: 1px solid rgb(var(--glow-2) / 0.3);
    border-radius: var(--radius-pill);
    background: rgb(5 6 15 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--fg);
    font: 450 var(--step--1) / 1.3 var(--font-mono);
  }
  .avail { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgb(52 211 153 / 0.6); }
  .sep { width: 1px; height: 0.9em; background: rgb(var(--glow-2) / 0.35); }
  /* Narrow screens: the role wraps to its own line, so drop the divider and soften the pill. */
  @media (max-width: 480px) { .status { border-radius: 0.875rem; row-gap: 0.25rem; } .sep { display: none; } }

  /* Cursor light: a soft cyan/cobalt glow that follows the pointer (--hx/--hy from interact.ts). */
  .light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(32rem circle at var(--hx, 70%) var(--hy, 40%), rgb(var(--glow-2) / 0.16), rgb(var(--glow-1) / 0.08) 35%, transparent 65%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Scrubbing visitors see frame 1 (the canvas's starting frame) instead of the poster, so there's no swap
     when the canvas takes over. Fallback visitors (reduced motion, Save-Data, 2g, no JS) never fetch it. */
  :global(.motion-hero) .hero { background: var(--bg) var(--start-desktop) 50% 100% / cover no-repeat; }
  :global(.motion-hero) .poster { opacity: 0; }
  @media (max-width: 767px) { :global(.motion-hero) .hero { background-image: var(--start-mobile); } }
  /* The hero's own pin spacer stays dark if a short screen leaves a gap below the pinned hero. */
  :global(.pin-spacer:has(> #hero)) { background: #05060f; }

  /* Parallax: the video drifts slightly against the pointer (--px/--py in -1..1 from interact.ts). */
  :global(.motion) .media { transform: translate3d(calc(var(--px, 0) * -14px), calc(var(--py, 0) * -10px), 0) scale(1.05); }

  /* Entrance: the copy rises in line by line at first paint (motion visitors only). */
  :global(.motion) [data-hero-copy] > * { animation: rise 0.7s var(--ease-out) both; }
  :global(.motion) [data-hero-copy] > :nth-child(2) { animation-delay: 0.08s; }
  :global(.motion) [data-hero-copy] > :nth-child(3) { animation-delay: 0.16s; }
  :global(.motion) [data-hero-copy] > :nth-child(4) { animation-delay: 0.24s; }
  :global(.motion) .dot { animation: pulse 2.4s ease-out infinite; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgb(52 211 153 / 0); } 100% { box-shadow: 0 0 0 0 rgb(52 211 153 / 0); } }

  /* The copy fades as the sequence resolves; keyboard focus always brings it back. */
  [data-hero-copy]:focus-within { opacity: 1 !important; }

  /* Short screens (phones in landscape): size to content so the CTA stays in view. */
  @media (max-height: 500px) {
    .hero { min-height: auto; padding-block: calc(4.5rem + var(--space-s)) var(--space-xl); }
    .status { margin-bottom: var(--space-s); }
    h1 { font-size: 2.25rem; margin-bottom: var(--space-s); }
    .lead { margin-bottom: var(--space-l); font-size: var(--step-0); }
  }
  /* The poster's grid sits low in the frame; anchor it to the bottom so it stays visible behind the copy. */
  .media { object-position: 50% 100%; }
</style>
